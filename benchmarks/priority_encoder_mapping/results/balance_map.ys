read_verilog priority_encoder.v
chparam -set WIDTH 16 -set LSB_HIGH_PRIORITY 0 priority_encoder
synth -top priority_encoder -flatten -noabc
abc -g simple -script balance_map.abc
opt_clean
check -assert
tee -o balance_map.stat stat
write_json balance_map.json
tee -o balance_map.ltp ltp -noff

title: "RadPareto: evidence-aware resource comparison"
type: software
version: "0.3.0"
date-released: "2026-11-21"
authors:
  - family-names: "Alizargar"
    given-names: "Javad"
    orcid: "https://orcid.org/0000-0003-2966-1315"
